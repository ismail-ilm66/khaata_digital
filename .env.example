# App settings, read at runtime with flutter_dotenv. Copy this file to .env
# (git-ignored) and fill it in; plain `flutter run` / `flutter build` pick
# it up. The file is bundled INSIDE the app, so never put secrets here.
# Leave a value empty to turn its feature off (e.g. Google Drive backup).

# Google Cloud → Credentials → OAuth client of type "Web application".
# Android sign-in uses this id (the Android client itself just has to exist
# with package com.expensetracker.kharcha and the app's SHA-1s).
GOOGLE_SERVER_CLIENT_ID=

# Google Cloud → Credentials → OAuth client of type "iOS"
# (bundle id com.expensetracker.kharcha).
GOOGLE_IOS_CLIENT_ID=

# Where "Contact us" (More → About) sends email. Empty: the button copies
# the diagnostics instead.
SUPPORT_EMAIL=
