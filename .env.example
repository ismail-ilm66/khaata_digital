# Build-time settings, passed with:
#   flutter run   --dart-define-from-file=.env
#   flutter build appbundle --release --dart-define-from-file=.env
# Copy this file to .env (git-ignored) and fill it in.
# Leave a value empty to build without Google Drive backup.

# Google Cloud → Credentials → OAuth client of type "Web application".
# Android sign-in uses this id (the Android client itself just has to exist
# with package com.expensetracker.kharcha and the app's SHA-1s).
GOOGLE_SERVER_CLIENT_ID=

# Google Cloud → Credentials → OAuth client of type "iOS"
# (bundle id com.expensetracker.kharcha).
GOOGLE_IOS_CLIENT_ID=
